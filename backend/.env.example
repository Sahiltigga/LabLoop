# LabLoop Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String Format:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>/labloop_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/labloop_db

# JWT Secret Key for Session Authentication
JWT_SECRET=your_jwt_secret_key_here

# Frontend Application Origin (CORS Allowed URL)
CLIENT_URL=http://localhost:5173

